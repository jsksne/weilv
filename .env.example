# 复制本文件为 .env 后只在本机填写，禁止提交真实密钥。
DASHSCOPE_API_KEY=

# 本机 POC 默认值。正式部署时必须使用外部托管 Elasticsearch 的 HTTPS 地址。
ELASTICSEARCH_URL=http://127.0.0.1:9200

# Elastic Cloud 等托管服务：优先使用 API key；或同时设置用户名和密码。
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_CA_CERTS=/path/to/ca.pem
# ELASTICSEARCH_VERIFY_CERTS=true

# Elastic Serverless 创建索引时设为 true；普通 Elasticsearch 保持 false。
# WEILV_ELASTICSEARCH_SERVERLESS=false

