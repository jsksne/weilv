{"task_id": "MT-BREAK-003", "title": "连续读写后的纯休息", "instruction": "连续读书或写字约40分钟后，先暂停读写约10分钟，再继续下一段学习。", "domain": "study_break", "covered_domains": ["study_break", "eye_health"], "evidence_chunk_ids": ["KC-SRC-003-003"], "safety_evidence_chunk_ids": ["KC-SRC-008-009"], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["reading", "writing", "homework", "self_study"], "trigger": "连续读写约40分钟", "estimated_minutes": 10, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生连续读写后需要简单休息、不指定具体恢复方式的场景。", "contraindications": [], "stop_conditions": ["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "这是最保守的基础休息任务，不额外指定来源没有要求的动作。", "execution_contexts": ["home", "school", "study_space"], "device_required_during_execution": false}
{"task_id": "MT-BREAK-004", "title": "课间离开座位活动", "instruction": "在允许自由活动的课间，尽量走出教室或离开座位活动一下。", "domain": "study_break", "covered_domains": ["study_break", "outdoor", "sedentary"], "evidence_chunk_ids": ["KC-SRC-008-004"], "safety_evidence_chunk_ids": [], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["school", "class_break", "between_classes"], "trigger": "在校且进入允许自由活动的课间", "estimated_minutes": 10, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生在校课间场景；不要求学生在学校实时打开微律，可在上学前或其他允许使用设备的时间获知任务后离线执行。", "contraindications": [], "stop_conditions": [], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "保留“课间”作为执行场景，删除“下一个课间”的强实时假设；微律不依赖学生在校实时使用设备。", "execution_contexts": ["school"], "device_required_during_execution": false}
{"task_id": "MT-SED-001", "title": "写作业久坐后的起身活动", "instruction": "如果写作业或自习已经连续坐了约1小时，起身活动约10分钟再继续。", "domain": "sedentary", "covered_domains": ["sedentary", "light_recovery"], "evidence_chunk_ids": ["KC-SRC-007-003"], "safety_evidence_chunk_ids": [], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["homework", "self_study", "long_sitting"], "trigger": "连续久坐约1小时", "estimated_minutes": 10, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生写作业、自习等久坐场景。", "contraindications": [], "stop_conditions": [], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "“活动”保持原证据泛化程度，不扩展为深蹲、拉伸、开合跳等具体动作。", "execution_contexts": ["home", "school", "study_space"], "device_required_during_execution": false}
{"task_id": "MT-SED-002", "title": "娱乐久坐后的起身活动", "instruction": "如果看视频、玩电脑或其他娱乐活动已经连续坐了约1小时，把接下来的约10分钟改成起身活动。", "domain": "sedentary", "covered_domains": ["sedentary", "light_recovery"], "evidence_chunk_ids": ["KC-SRC-007-003"], "safety_evidence_chunk_ids": [], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["screen_entertainment", "gaming", "long_sitting"], "trigger": "娱乐久坐约1小时", "estimated_minutes": 10, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生非学习久坐场景。", "contraindications": [], "stop_conditions": [], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "同一证据按不同用户场景生成任务；不新增具体运动动作。", "execution_contexts": ["home"], "device_required_during_execution": false}
{"task_id": "MT-EYE-001", "title": "读写姿势快速复位", "instruction": "开始或继续写作业前，检查一次读写姿势：眼睛离书本约一尺、胸口离桌边约一拳、手指离笔尖约一寸。", "domain": "eye_health", "covered_domains": ["eye_health"], "evidence_chunk_ids": ["KC-SRC-003-002", "KC-SRC-008-008"], "safety_evidence_chunk_ids": ["KC-SRC-008-009"], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["reading", "writing", "homework", "posture_check"], "trigger": "开始或继续读写前", "estimated_minutes": 1, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生读写场景。", "contraindications": [], "stop_conditions": ["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "属于姿势检查，不延伸为疼痛治疗或脊柱矫正。", "execution_contexts": ["home", "school", "study_space"], "device_required_during_execution": false}
{"task_id": "MT-EYE-002", "title": "停止躺着看书或看屏幕", "instruction": "如果现在正躺着看书或使用电子产品，先坐起或换到正常读写姿势再继续。", "domain": "eye_health", "covered_domains": ["eye_health"], "evidence_chunk_ids": ["KC-SRC-003-002", "KC-SRC-008-008"], "safety_evidence_chunk_ids": ["KC-SRC-008-009"], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["reading", "screen_use", "lying_down"], "trigger": "躺卧状态下阅读或使用电子产品", "estimated_minutes": 1, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生阅读及电子产品使用场景。", "contraindications": [], "stop_conditions": ["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "", "execution_contexts": ["home", "school", "study_space"], "device_required_during_execution": false}
{"task_id": "MT-EYE-003", "title": "移动场景先暂停阅读", "instruction": "如果正在走路、吃饭或处于晃动的车厢里，先暂停看书或使用电子产品，等环境稳定后再继续。", "domain": "eye_health", "covered_domains": ["eye_health"], "evidence_chunk_ids": ["KC-SRC-003-002"], "safety_evidence_chunk_ids": ["KC-SRC-008-009"], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["walking", "eating", "moving_vehicle", "screen_use", "reading"], "trigger": "在走路、吃饭或晃动车厢内阅读/看屏幕", "estimated_minutes": 1, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生移动或不稳定环境中的阅读/屏幕场景。", "contraindications": [], "stop_conditions": ["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "", "execution_contexts": ["commute", "home", "school"], "device_required_during_execution": false}
