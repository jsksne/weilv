{"task_id": "MT-OUT-001", "title": "读写后的户外休息", "instruction": "连续读写约40分钟后，如果当前条件允许，把接下来的约10分钟休息安排到户外。", "domain": "outdoor", "covered_domains": ["outdoor", "study_break", "eye_health"], "evidence_chunk_ids": ["KC-SRC-003-003", "KC-SRC-008-006"], "safety_evidence_chunk_ids": ["KC-SRC-008-009"], "target_stage": ["primary_upper", "junior_high", "senior_high"], "context_tags": ["reading", "writing", "outdoor", "study_break"], "trigger": "连续读写约40分钟且可安全到户外", "estimated_minutes": 10, "burden_level": "low", "safety_level": "low", "applicability": "小学4～6年级、初中生和高中生学习后的可户外休息场景。", "contraindications": [], "stop_conditions": ["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"], "review_status": "pending_human_review", "ai_review_recommendation": "recommended_pass", "reviewer_notes": "不把户外2小时总体目标直接包装成一次2小时微任务。", "execution_contexts": ["school", "home", "outdoor"], "device_required_during_execution": false}
