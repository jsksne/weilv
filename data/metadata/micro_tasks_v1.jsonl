{"task_id":"MT-BREAK-001","title":"连续读写后的远眺休息","instruction":"连续读书或写字约40分钟后，暂停当前任务约10分钟，并看向较远处休息。","domain":"study_break","covered_domains":["study_break","eye_health"],"evidence_chunk_ids":["KC-SRC-003-003","KC-SRC-008-006"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","writing","homework","self_study"],"trigger":"连续读写约40分钟","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生连续阅读、写作业、复习场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-BREAK-002","title":"电子学习后的离屏远眺","instruction":"课余使用电子产品学习约30～40分钟后，离开屏幕并远眺放松约10分钟。","domain":"study_break","covered_domains":["study_break","eye_health"],"evidence_chunk_ids":["KC-SRC-003-004A","KC-SRC-008-006","KC-SRC-007-002"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["screen_learning","homework","online_learning"],"trigger":"课余电子产品学习约30～40分钟","execution_contexts":["home","school","study_space"],"device_required_during_execution":true,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生课余电子学习场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-BREAK-003","title":"连续读写后的纯休息","instruction":"连续读书或写字约40分钟后，先暂停读写约10分钟，再继续下一段学习。","domain":"study_break","covered_domains":["study_break","eye_health"],"evidence_chunk_ids":["KC-SRC-003-003"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","writing","homework","self_study"],"trigger":"连续读写约40分钟","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生连续读写后需要简单休息、不指定具体恢复方式的场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["continue_study"]}
{"task_id":"MT-BREAK-004","title":"课间离开座位活动","instruction":"在允许自由活动的课间，尽量走出教室或离开座位活动一下。","domain":"study_break","covered_domains":["study_break","outdoor","sedentary"],"evidence_chunk_ids":["KC-SRC-008-004"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["school","class_break","between_classes"],"trigger":"在校且进入允许自由活动的课间","execution_contexts":["school"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生在校课间场景；不要求学生在学校实时打开微律，可在上学前或其他允许使用设备的时间获知任务后离线执行。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":["requires_standing","requires_movement"]}
{"task_id":"MT-SED-001","title":"写作业久坐后的起身活动","instruction":"如果写作业或自习已经连续坐了约1小时，起身活动约10分钟再继续。","domain":"sedentary","covered_domains":["sedentary","light_recovery"],"evidence_chunk_ids":["KC-SRC-007-003"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["homework","self_study","long_sitting"],"trigger":"连续久坐约1小时","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生写作业、自习等久坐场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":["requires_standing","requires_movement","continue_study"]}
{"task_id":"MT-SED-002","title":"娱乐久坐后的起身活动","instruction":"如果看视频、玩电脑或其他娱乐活动已经连续坐了约1小时，把接下来的约10分钟改成起身活动。","domain":"sedentary","covered_domains":["sedentary","light_recovery"],"evidence_chunk_ids":["KC-SRC-007-003"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["screen_entertainment","gaming","long_sitting"],"trigger":"娱乐久坐约1小时","execution_contexts":["home"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生非学习久坐场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":["requires_standing","requires_movement"]}
{"task_id":"MT-EYE-001","title":"读写姿势快速复位","instruction":"开始或继续写作业前，检查一次读写姿势：眼睛离书本约一尺、胸口离桌边约一拳、手指离笔尖约一寸。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-003-002","KC-SRC-008-008"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","writing","homework","posture_check"],"trigger":"开始或继续读写前","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生读写场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["continue_study"]}
{"task_id":"MT-EYE-002","title":"停止躺着看书或看屏幕","instruction":"如果现在正躺着看书或使用电子产品，先坐起或换到正常读写姿势再继续。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-003-002","KC-SRC-008-008"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","screen_use","lying_down"],"trigger":"躺卧状态下阅读或使用电子产品","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生阅读及电子产品使用场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["continue_study"]}
{"task_id":"MT-EYE-003","title":"移动场景先暂停阅读","instruction":"如果正在走路、吃饭或处于晃动的车厢里，先暂停看书或使用电子产品，等环境稳定后再继续。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-003-002"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["walking","eating","moving_vehicle","screen_use","reading"],"trigger":"在走路、吃饭或晃动车厢内阅读/看屏幕","execution_contexts":["commute","home","school"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生移动或不稳定环境中的阅读/屏幕场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["pause_reading_or_screen","continue_study"]}
{"task_id":"MT-EYE-004","title":"换到合适光线再读写","instruction":"如果当前环境光线暗弱或有阳光直射，先换到更合适的读写环境再继续看书或使用电子产品。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-003-002"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","screen_use","poor_lighting"],"trigger":"光线暗弱或阳光直射时准备读写/看屏幕","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":2,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生读写与电子产品使用场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["continue_study"]}
{"task_id":"MT-EYE-005","title":"检查电脑观看距离","instruction":"使用电脑学习时，检查一次眼睛到屏幕的水平距离；如果明显小于50厘米，适当拉开到不小于50厘米。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-008-002A"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["computer","screen_learning","distance_check"],"trigger":"使用电脑学习","execution_contexts":["home","school","study_space"],"device_required_during_execution":true,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生电脑学习场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-EYE-006","title":"检查手机观看距离","instruction":"使用手机时，检查一次眼睛到手机的距离；如果明显小于40厘米，适当拉开到不小于40厘米。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-008-002A"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["phone","screen_use","distance_check"],"trigger":"使用手机","execution_contexts":["home","school","commute","study_space"],"device_required_during_execution":true,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生手机使用场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-EYE-007","title":"晚间学习同时开台灯和顶灯","instruction":"晚上在家学习时，如果只开了台灯，把房间顶灯也打开后再继续学习。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-008-002A"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["evening_study","homework","lighting"],"trigger":"晚间在家学习且仅使用台灯","execution_contexts":["home"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生晚间家庭学习场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["continue_study"]}
{"task_id":"MT-EYE-008","title":"有条件时选择更大屏幕学习","instruction":"需要网络学习时，如果手边已有多种设备可选，优先选择相对大尺寸的屏幕，而不是更小的屏幕。","domain":"eye_health","covered_domains":["eye_health"],"evidence_chunk_ids":["KC-SRC-008-002A"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["online_learning","device_choice"],"trigger":"网络学习前且已有多种设备可选","execution_contexts":["home","school","study_space"],"device_required_during_execution":true,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生网络学习设备选择场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-001","title":"睡前停止玩手机和电子产品","instruction":"准备睡觉后，不再玩手机或其他电子产品，把它们放到一边。","domain":"sleep","covered_domains":["sleep","eye_health"],"evidence_chunk_ids":["KC-SRC-001-007","KC-SRC-008-002B"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["bedtime","phone","screen_use"],"trigger":"准备睡觉","execution_contexts":["home","bedroom"],"device_required_during_execution":true,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生睡前场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-002","title":"今晚按平时固定时间睡觉","instruction":"今晚尽量按自己平时的固定睡眠时间上床睡觉，不因为普通学习安排随意把睡觉时间继续往后拖。","domain":"sleep","covered_domains":["sleep"],"evidence_chunk_ids":["KC-SRC-001-006","KC-SRC-007-004"],"safety_evidence_chunk_ids":["KC-SRC-004-003","KC-SRC-004-004"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["bedtime","routine","school_night"],"trigger":"临近通常睡眠时间","execution_contexts":["home","bedroom"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生日常作息场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-003","title":"周末起床时间别偏太多","instruction":"周末安排起床时间时，尽量让平均起床时间与上学日相比不超过1小时。","domain":"sleep","covered_domains":["sleep"],"evidence_chunk_ids":["KC-SRC-008-007","KC-SRC-001-006"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["weekend","wake_time","routine"],"trigger":"安排周末起床时间","execution_contexts":["home"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生周末作息场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-004","title":"夜间减少高亮电子屏暴露","instruction":"临近睡觉时，减少继续暴露在高亮度电子产品屏幕前的时间。","domain":"sleep","covered_domains":["sleep","eye_health"],"evidence_chunk_ids":["KC-SRC-008-002B","KC-SRC-001-007"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["bedtime","screen_use","night"],"trigger":"临近睡眠时间仍在使用高亮电子屏","execution_contexts":["home","bedroom"],"device_required_during_execution":true,"estimated_minutes":5,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生睡前电子屏使用场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-005","title":"睡觉时关闭夜灯","instruction":"准备睡觉时，如果没有其他安全需要，关闭夜灯后再入睡。","domain":"sleep","covered_domains":["sleep"],"evidence_chunk_ids":["KC-SRC-008-002B"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["bedtime","bedroom_environment","night_light"],"trigger":"准备睡觉且夜灯开启","execution_contexts":["home","bedroom"],"device_required_during_execution":false,"estimated_minutes":1,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生卧室睡眠环境场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-SLEEP-006","title":"夜间把卧室光线挡暗一些","instruction":"如果夜间窗外光线明显影响卧室变暗，可以使用现有窗帘把外界光线挡住后再睡觉。","domain":"sleep","covered_domains":["sleep"],"evidence_chunk_ids":["KC-SRC-008-002B"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["bedtime","bedroom_environment","external_light"],"trigger":"夜间卧室受窗外光线影响","execution_contexts":["home","bedroom"],"device_required_during_execution":false,"estimated_minutes":2,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生卧室夜间光环境场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":[]}
{"task_id":"MT-OUT-001","title":"读写后的户外休息","instruction":"连续读写约40分钟后，如果当前条件允许，把接下来的约10分钟休息安排到户外。","domain":"outdoor","covered_domains":["outdoor","study_break","eye_health"],"evidence_chunk_ids":["KC-SRC-003-003","KC-SRC-008-006"],"safety_evidence_chunk_ids":["KC-SRC-008-009"],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","writing","outdoor","study_break"],"trigger":"连续读写约40分钟且可安全到户外","execution_contexts":["school","home","outdoor"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生学习后的可户外休息场景。","contraindications":[],"stop_conditions":["若出现明显视力异常迹象，不继续依赖普通微任务，转入求助/安全流程。"],"review_status":"content_reviewed","safety_capabilities":["requires_outdoor"]}
{"task_id":"MT-REC-001","title":"读写后的轻微活动","instruction":"连续读写约40分钟后，利用约10分钟休息做一些轻微活动，让自己从持续读写状态中停下来。","domain":"light_recovery","covered_domains":["light_recovery","study_break","sedentary"],"evidence_chunk_ids":["KC-SRC-003-003","KC-SRC-008-006"],"safety_evidence_chunk_ids":[],"target_stage":["primary_upper","junior_high","senior_high"],"context_tags":["reading","writing","light_activity","study_break"],"trigger":"连续读写约40分钟","execution_contexts":["home","school","study_space"],"device_required_during_execution":false,"estimated_minutes":10,"burden_level":"low","safety_level":"low","applicability":"小学4～6年级、初中生和高中生连续读写后的短时恢复场景。","contraindications":[],"stop_conditions":[],"review_status":"content_reviewed","safety_capabilities":["requires_movement"]}
